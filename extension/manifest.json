{
  "manifest_version": 3,
  "name": "Orange Gesture Control",
  "short_name": "OGC",
  "version": "2.0.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "ogc@orange-ftgroup.com",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "sessions",
    "history",
    "bookmarks",
    "contextMenus",
    "notifications",
    "clipboardRead",
    "clipboardWrite",
    "downloads",
    "find"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background/service_worker.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/vocabulary.js",
        "lib/recognizer.js",
        "content_scripts/trails.js",
        "content_scripts/tooltips.js",
        "content_scripts/long_click.js",
        "content_scripts/gestures.js"
      ],
      "css": ["content_scripts/ogc.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Orange Gesture Control",
    "default_icon": {
      "16": "icons/ogc-16.png",
      "32": "icons/ogc-32.png",
      "48": "icons/ogc-48.png"
    }
  },
  "sidebar_action": {
    "default_title": "OGC — Aide gestes",
    "default_panel": "sidebar/sidebar.html",
    "default_icon": "icons/ogc-32.png"
  },
  "icons": {
    "16": "icons/ogc-16.png",
    "32": "icons/ogc-32.png",
    "48": "icons/ogc-48.png",
    "128": "icons/ogc-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["wasm/ogc_recognizer.wasm", "img/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}